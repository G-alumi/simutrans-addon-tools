{
  "name": "simutrans-addon-tools",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "G-alumi",
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/G-alumi/simutrans-addon-tools.git"
  },
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:simutrans-dat"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "simutrans-dat",
        "aliases": ["Simutrans dat", "simutrans-dat"],
        "extensions": [".dat"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "simutrans-dat",
        "scopeName": "source.simutrans-dat",
        "path": "./syntaxes/dat.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "simutrans-addon-tools.pakSize": {
          "type": "integer",
          "default": 128,
          "minimum": 16,
          "maximum": 32765,
          "scope": "resource",
          "markdownDescription": "%config.pakSize%"
        },
        "simutrans-addon-tools.pakSizeOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "integer",
            "minimum": 16,
            "maximum": 32765
          },
          "scope": "resource",
          "markdownDescription": "%config.pakSizeOverrides%"
        },
        "simutrans-addon-tools.imagePreview": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.imagePreview%"
        },
        "simutrans-addon-tools.diagnostics.unknownKey": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.unknownKey%"
        },
        "simutrans-addon-tools.diagnostics.unresolvedReference": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.unresolvedReference%"
        },
        "simutrans-addon-tools.diagnostics.missingImage": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.missingImage%"
        },
        "simutrans-addon-tools.diagnostics.constraintMismatch": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.constraintMismatch%"
        },
        "simutrans-addon-tools.diagnostics.constraintMismatchSeverity": {
          "type": "string",
          "enum": ["error", "warning"],
          "default": "error",
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.constraintMismatchSeverity%"
        },
        "simutrans-addon-tools.diagnostics.ignoreKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.ignoreKeys%"
        },
        "simutrans-addon-tools.diagnostics.ignoreReferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "good/Passagiere",
            "good/Post",
            "good/None"
          ],
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.ignoreReferences%"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "simutrans-addon-tools.imageViewer",
        "displayName": "%customEditor.imageViewer%",
        "selector": [
          { "filenamePattern": "*.png" },
          { "filenamePattern": "*.jpg" },
          { "filenamePattern": "*.jpeg" },
          { "filenamePattern": "*.gif" },
          { "filenamePattern": "*.bmp" },
          { "filenamePattern": "*.webp" },
          { "filenamePattern": "*.svg" },
          { "filenamePattern": "*.ico" },
          { "filenamePattern": "*.apd" }
        ],
        "priority": "default"
      },
      {
        "viewType": "simutrans-addon-tools.pakViewer",
        "displayName": "%customEditor.pakViewer%",
        "selector": [
          { "filenamePattern": "*.pak" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:pak": "npm run compile-tests && mocha --ui tdd \"out/test/pak/**/*.test.js\"",
    "test:dat": "npm run compile-tests && mocha --ui tdd \"out/test/dat/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.8",
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.117.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.11.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "apd-js-tools": "https://github.com/G-alumi/apd-js-tools/releases/latest/download/apd-js-tools-0.1.1.tgz"
  }
}
